<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeSurveyApp.SurveyPage"
             Title="Анкета о кофе">

       <ScrollView>

              <VerticalStackLayout Padding="20"
                                   Spacing="14">

                     <!-- ===================== HEADER (Grid) ===================== -->
                     <Grid RowDefinitions="Auto,Auto"
                           ColumnDefinitions="100,*"
                           Margin="0,0,0,10">

                            <Image Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.RowSpan="2"
                                   Source="coffee_cup.png"
                                   Aspect="AspectFit"
                                   HeightRequest="90"
                                   Margin="0,0,10,0"/>

                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="Анкета предпочтений в кофе"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   Margin="0,5,0,0"/>

                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Расскажите, какой кофе вы любите ☕"
                                   FontSize="14"
                                   FontAttributes="Italic"
                                   Margin="0,2,0,0"/>
                     </Grid>

                     <!-- ===================== BASIC INFO ===================== -->
                     <Entry x:Name="NameEntry"
                            Placeholder="Полное имя"
                            Keyboard="Text"
                            MaxLength="50"
                            Margin="0,5,0,0"
                            TextChanged="OnRequiredFieldChanged"/>

                     <Entry x:Name="EmailEntry"
                            Placeholder="Электронная почта"
                            Keyboard="Email"
                            MaxLength="100"
                            Margin="0,5,0,0"
                            TextChanged="OnRequiredFieldChanged"/>

                     <Editor x:Name="CommentsEditor"
                             Placeholder="Дополнительные комментарии"
                             AutoSize="TextChanges"
                             MaxLength="300"
                             Margin="0,5,0,0"/>

                     <!-- ===================== COFFEE TYPE ===================== -->
                     <Picker x:Name="CoffeeTypePicker"
                             Title="Выберите любимый вид кофе"
                             Margin="0,10,0,0">
                            <Picker.Items>
                                   <x:String>Эспрессо</x:String>
                                   <x:String>Латте</x:String>
                                   <x:String>Капучино</x:String>
                                   <x:String>Американо</x:String>
                            </Picker.Items>
                     </Picker>

                     <!-- ===================== STRENGTH (RadioButtons) ===================== -->
                     <VerticalStackLayout Spacing="4"
                                          Margin="0,10,0,0">
                            <Label Text="Крепость кофе:"
                                   FontSize="16"
                                   FontAttributes="Bold"/>

                            <RadioButton x:Name="LightRadio"
                                         Content="Слабая"
                                         GroupName="StrengthGroup"
                                         Value="Light"/>

                            <RadioButton x:Name="MediumRadio"
                                         Content="Средняя"
                                         GroupName="StrengthGroup"
                                         Value="Medium"
                                         IsChecked="True"/>

                            <RadioButton x:Name="StrongRadio"
                                         Content="Крепкая"
                                         GroupName="StrengthGroup"
                                         Value="Strong"/>
                     </VerticalStackLayout>

                     <!-- ===================== EXTRAS (CheckBoxes) ===================== -->
                     <HorizontalStackLayout Spacing="20"
                                            Margin="0,10,0,0">

                            <HorizontalStackLayout Spacing="4">
                                   <CheckBox x:Name="MilkCheck"
                                             IsChecked="False"
                                             Color="SaddleBrown"/>
                                   <Label Text="Добавить молоко"
                                          VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="4">
                                   <CheckBox x:Name="SugarCheck"
                                             IsChecked="False"
                                             Color="Chocolate"/>
                                   <Label Text="Добавить сахар"
                                          VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                     </HorizontalStackLayout>

                     <!-- ===================== NEWSLETTER (Switch) ===================== -->
                     <HorizontalStackLayout Spacing="10"
                                            Margin="0,10,0,0">
                            <Label Text="Подписаться на рассылку"
                                   VerticalOptions="Center"/>
                            <Switch x:Name="NewsletterSwitch"
                                    IsToggled="False"
                                    OnColor="SaddleBrown"/>
                     </HorizontalStackLayout>

                     <!-- ===================== BIRTH DATE ===================== -->
                     <Label Text="Дата рождения:"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,10,0,0"/>
                     <DatePicker x:Name="BirthDatePicker"
                                 Format="dd/MM/yyyy"
                                 Date="2000-01-01"
                                 MinimumDate="1940-01-01"
                                 MaximumDate="2026-10-06"/>

                     <!-- ===================== CUPS PER DAY (Slider + x:Reference binding) ===================== -->
                     <Label Text="{Binding Source={x:Reference CupsSlider}, Path=Value, Mode=OneWay, StringFormat='Чашек в день: {0:F0}'}"
                            FontSize="16"
                            Margin="0,10,0,0"/>

                     <Slider x:Name="CupsSlider"
                             Minimum="1"
                             Maximum="10"
                             Value="3"/>

                     <!-- ===================== RESULT ===================== -->
                     <Label x:Name="ResultLabel"
                            Text=""
                            FontSize="15"
                            IsVisible="False"
                            Margin="0,15,0,0"/>

                     <!-- ===================== BUTTONS ===================== -->
                     <HorizontalStackLayout Spacing="15"
                                            Margin="0,15,0,20">
                            <Button x:Name="ShowResultButton"
                                    Text="Показать результат"
                                    IsEnabled="False"
                                    Clicked="ShowResultButton_Clicked"/>

                            <Button Text="Очистить"
                                    Clicked="ClearButton_Clicked"/>
                     </HorizontalStackLayout>

              </VerticalStackLayout>
       </ScrollView>
</ContentPage>
